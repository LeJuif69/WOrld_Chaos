rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserSave(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'version', 'savedAt', 'playTimeSeconds', 'playerPosition',
          'playerYaw', 'hp', 'maxHp', 'chaosEnergy', 'maxChaosEnergy',
          'xp', 'level', 'enemiesDefeatedCount', 'chaosEventsSurvived',
          'inventory', 'quests', 'worldState', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'version', 'savedAt', 'playTimeSeconds', 'playerPosition',
          'playerYaw', 'hp', 'maxHp', 'chaosEnergy', 'maxChaosEnergy',
          'xp', 'level', 'enemiesDefeatedCount', 'chaosEventsSurvived',
          'inventory', 'quests', 'worldState', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId == userId
        && isValidId(data.ownerId)
        && data.version is int && data.version == 1
        && data.savedAt is string && data.savedAt.size() >= 10 && data.savedAt.size() <= 64
        && data.playTimeSeconds is number && data.playTimeSeconds >= 0 && data.playTimeSeconds <= 10000000
        && data.playerPosition is list && data.playerPosition.size() == 3
        && data.playerPosition[0] is number && data.playerPosition[1] is number && data.playerPosition[2] is number
        && data.playerYaw is number && data.playerYaw >= -10 && data.playerYaw <= 10
        && data.hp is number && data.hp >= 0 && data.hp <= 1000
        && data.maxHp is number && data.maxHp >= 50 && data.maxHp <= 1000
        && data.chaosEnergy is number && data.chaosEnergy >= 0 && data.chaosEnergy <= 1000
        && data.maxChaosEnergy is number && data.maxChaosEnergy >= 50 && data.maxChaosEnergy <= 1000
        && data.xp is number && data.xp >= 0 && data.xp <= 10000000
        && data.level is int && data.level >= 1 && data.level <= 99
        && data.enemiesDefeatedCount is int && data.enemiesDefeatedCount >= 0 && data.enemiesDefeatedCount <= 1000000
        && data.chaosEventsSurvived is int && data.chaosEventsSurvived >= 0 && data.chaosEventsSurvived <= 1000000
        && data.inventory is list && data.inventory.size() <= 30
        && (data.inventory.size() == 0 || data.inventory[0] is map)
        && data.quests is map && data.quests.keys().size() <= 15
        && data.worldState is map && data.worldState.keys().size() <= 20
        && data.updatedAt == request.time;
    }

    function isValidLeaderboardEntry(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'displayName', 'level', 'xp', 'bossDefeated',
          'chaosCoreObtained', 'playTimeSeconds', 'enemiesDefeatedCount', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'displayName', 'level', 'xp', 'bossDefeated',
          'chaosCoreObtained', 'playTimeSeconds', 'enemiesDefeatedCount', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId == userId
        && isValidId(data.ownerId)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 32
        && data.level is int && data.level >= 1 && data.level <= 99
        && data.xp is number && data.xp >= 0 && data.xp <= 10000000
        && data.bossDefeated is bool
        && data.chaosCoreObtained is bool
        && data.playTimeSeconds is number && data.playTimeSeconds >= 0 && data.playTimeSeconds <= 10000000
        && data.enemiesDefeatedCount is int && data.enemiesDefeatedCount >= 0 && data.enemiesDefeatedCount <= 1000000
        && data.updatedAt == request.time;
    }

    // Startup connection validation probe (read-only)
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // Private cloud saves strictly scoped to owner UID
    match /users/{userId}/saves/{saveId} {
      allow get: if isValidId(userId) && isValidId(saveId) && isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isValidId(userId) && isValidId(saveId) && isOwner(userId)
        && isValidUserSave(incoming(), userId);
      allow update: if isValidId(userId) && isValidId(saveId) && isOwner(userId)
        && isValidUserSave(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'version', 'savedAt', 'playTimeSeconds', 'playerPosition', 'playerYaw',
          'hp', 'maxHp', 'chaosEnergy', 'maxChaosEnergy', 'xp', 'level',
          'enemiesDefeatedCount', 'chaosEventsSurvived', 'inventory', 'quests',
          'worldState', 'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isValidId(saveId) && isOwner(userId);
    }

    // Public Explorer Mastery Leaderboard (zero PII)
    match /leaderboard/{userId} {
      allow get: if isValidId(userId);
      allow list: if true;
      allow create: if isValidId(userId) && isOwner(userId)
        && isValidLeaderboardEntry(incoming(), userId);
      allow update: if isValidId(userId) && isOwner(userId)
        && isValidLeaderboardEntry(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'level', 'xp', 'bossDefeated', 'chaosCoreObtained',
          'playTimeSeconds', 'enemiesDefeatedCount', 'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isOwner(userId);
    }
  }
}
